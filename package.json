{
  "name": "playwright-koans",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on practice for QA engineers: 65 failing Playwright tests to fix, plus a website with in-browser exercises and interview questions.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "next": "playwright test --project=koans --workers=1 --max-failures=1",
    "koan": "playwright test --project=koans",
    "koans": "playwright test --project=koans",
    "diagnostic": "playwright test --project=koans --grep @diagnostic",
    "solutions": "playwright test --project=solutions",
    "ui": "playwright test --project=koans --ui",
    "report": "playwright show-report",
    "app": "node app/server.mjs",
    "typecheck": "tsc --noEmit",
    "site:build": "node site/build.mjs",
    "site": "node site/build.mjs && node site/serve.mjs",
    "site:check": "node site/check-content.mjs",
    "site:test": "playwright test -c playwright.site.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "marked": "18.1.0",
    "typescript": "7.0.2"
  }
}
